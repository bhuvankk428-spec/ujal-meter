APP_NAME="Urja Meter Ops API"
ENVIRONMENT=dev
LOG_LEVEL=INFO
ADMIN_API_KEY=dev-admin-key
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=20
WARM_CACHE_ON_STARTUP=false

URJA_BASE_URL=http://127.0.0.1:9000
URJA_USERNAME=operator@urja.example
URJA_PASSWORD=urja-demo-pass
URJA_TIMEZONE=Asia/Kolkata

PORTAL_CONNECT_TIMEOUT_S=3
PORTAL_READ_TIMEOUT_S=10
PORTAL_TOTAL_TIMEOUT_S=15
PORTAL_MAX_CONCURRENCY=5
PORTAL_MAX_RETRIES=2
PORTAL_RETRY_BASE_DELAY_S=0.25
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_TIMEOUT_S=20

CACHE_METERS_FRESH_S=600
CACHE_METERS_STALE_S=3600
CACHE_METER_FRESH_S=300
CACHE_METER_STALE_S=1800
CACHE_CONSUMPTION_FRESH_S=120
CACHE_CONSUMPTION_STALE_S=3600
CACHE_CONSUMPTION_CLOSED_FRESH_S=3600
CACHE_CONSUMPTION_CLOSED_STALE_S=86400
CACHE_HIERARCHY_FRESH_S=600
CACHE_HIERARCHY_STALE_S=3600

MOCK_SESSION_TTL_SECONDS=900
MOCK_CONTROL_ENABLED=true
